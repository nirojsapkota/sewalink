= render "admin/accounting/subnav"
h1.text-2xl.font-semibold.text-slate-900.mb-4 Transaction ##{@line.id}
.grid.grid-cols-1.md:grid-cols-2.gap-6
  div class=card_class
    h2.mb-2.font-semibold.text-slate-900 This Line
    p Account: = @line[:account]
    p Scope: = @line[:scope]
    p Code: = @line[:code]
    p Amount: = money_from_cents(@line[:amount])
    p Created: = @line.created_at.strftime("%Y-%m-%d %H:%M")
  div class=card_class
    h2.mb-2.font-semibold.text-slate-900 Paired Line
    - if @partner_line
      p Account: = @partner_line[:account]
      p Scope: = @partner_line[:scope]
      p Amount: = money_from_cents(@partner_line[:amount])
    - else
      p.text-slate-400 No paired line found.
- if @linked_task
  div class="#{card_class} mt-6"
    h2.mb-2.font-semibold.text-slate-900 Linked Task
    p = link_to @linked_task.title, admin_task_path(@linked_task), class: "text-sm font-medium text-indigo-600 hover:text-indigo-700"
    p Poster: = @linked_task.user&.first_name
    p Tasker: = @linked_task.tasker&.first_name
    p
      | Status:
      span.inline-flex.items-center.rounded-full.px-2.5.py-0.5.text-xs.font-semibold class=status_badge_class(@linked_task.status)
        = @linked_task.status
    - if @dispute_logs.present?
      h3.font-semibold.mt-4.mb-1.text-slate-900 Dispute Resolution History
      ul
        - @dispute_logs.each do |log|
          li = "#{log.created_at.strftime('%Y-%m-%d')} — #{log.action} by #{log.admin.first_name}: #{JSON.parse(log.details)['decision']}"
- if @linked_user
  div class="#{card_class} mt-6"
    h2.mb-2.font-semibold.text-slate-900 Linked User
    p = link_to "#{@linked_user.first_name} #{@linked_user.last_name}", admin_user_path(@linked_user), class: "text-sm font-medium text-indigo-600 hover:text-indigo-700"
