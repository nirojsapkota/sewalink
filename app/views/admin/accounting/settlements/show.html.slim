= render "admin/accounting/subnav"
h1.text-2xl.font-semibold.text-slate-900.mb-4 Settlement ##{@settlement.transaction_ref}
div class=card_class
  p Amount: = money_from_cents(@settlement.amount_cents)
  p Settled On: = @settlement.settled_on
  p
    | Status:
    span.inline-flex.items-center.rounded-full.px-2.5.py-0.5.text-xs.font-semibold class=status_badge_class(@matched_line ? :payment_completed : :dispute)
      = @settlement.status
  - if @matched_line
    h2.font-semibold.mt-4.text-slate-900 Matched Ledger Line
    p Account: = @matched_line[:account]
    p Amount: = money_from_cents(@matched_line[:amount])
    p Created: = @matched_line.created_at.strftime("%Y-%m-%d %H:%M")
  - else
    p.text-red-700.mt-4 No matching internal ledger line found for this settlement.
