.mb-8
  h1.text-3xl.font-semibold.text-slate-900
    | Bid Management
.mb-8.border-b.border-slate-200
  nav.-mb-px.flex.space-x-8
    = link_to "All", admin_bids_path, class: "#{params[:status].blank? ? 'border-indigo-500 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300'} whitespace-nowrap border-b-2 px-1 py-4 text-sm font-medium"
    - Bid.statuses.keys.each do |status|
      = link_to status.humanize, admin_bids_path(status: status), class: "#{params[:status] == status ? 'border-indigo-500 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300'} whitespace-nowrap border-b-2 px-1 py-4 text-sm font-medium"
.bg-white.rounded-lg.shadow.overflow-hidden
  table.min-w-full.divide-y.divide-slate-200
    thead.bg-slate-50
      tr
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Task
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Tasker
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Amount
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Status
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Placed At
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Actions
    tbody.bg-white.divide-y.divide-slate-200
      - @bids.each do |bid|
        tr
          td.px-6.py-4.whitespace-nowrap.text-sm.font-medium.text-slate-900
            = link_to bid.task.title.truncate(30), admin_task_path(bid.task), class: "text-indigo-600 hover:text-indigo-700"
          td.px-6.py-4.whitespace-nowrap.text-sm.text-slate-500
            = bid.user.name || bid.user.phone
          td.px-6.py-4.whitespace-nowrap.text-sm.text-slate-500
            = number_to_currency(bid.amount, unit: "Rs. ")
          td.px-6.py-4.whitespace-nowrap
            - badge_status = bid.accepted? ? :payment_completed : (bid.rejected? ? :dispute : :pending_payment)
            span class="inline-flex rounded-full px-2 py-0.5 text-xs font-semibold #{status_badge_class(badge_status)}"
              = bid.status.humanize
          td.px-6.py-4.whitespace-nowrap.text-sm.text-slate-500
            = bid.created_at.strftime("%Y-%m-%d %H:%M")
          td.px-6.py-4.whitespace-nowrap.text-sm.font-medium
            .flex.gap-2
              - unless bid.rejected?
                = button_to "Reject", reject_admin_bid_path(bid), method: :patch, class: button_class(:destructive), data: { confirm: "Force-reject this bid? #{'This will revert the task to open.' if bid.accepted?}" }
              - if bid.pending? && bid.task.open?
                = button_to "Accept", accept_admin_bid_path(bid), method: :patch, class: button_class(:primary)
      - if @bids.empty?
        tr
          td.px-6.py-10.text-center.text-slate-500[colspan="6"]
            | No bids found.
.mt-8
  = paginate @bids
