.mb-8
  h1.text-3xl.font-bold
    | Bid Management
.mb-8.border-b.border-gray-200
  nav.-mb-px.flex.space-x-8
    = link_to "All", admin_bids_path, class: "#{params[:status].blank? ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"
    - Bid.statuses.keys.each do |status|
      = link_to status.humanize, admin_bids_path(status: status), class: "#{params[:status] == status ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"
.bg-white.rounded-lg.shadow.overflow-hidden
  table.min-w-full.divide-y.divide-gray-200
    thead.bg-gray-50
      tr
        th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider
          | Task
        th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider
          | Tasker
        th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider
          | Amount
        th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider
          | Status
        th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider
          | Placed At
        th.px-6.py-3.text-left.text-xs.font-medium.text-gray-500.uppercase.tracking-wider
          | Actions
    tbody.bg-white.divide-y.divide-gray-200
      - @bids.each do |bid|
        tr
          td.px-6.py-4.whitespace-nowrap.text-sm.font-medium.text-gray-900
            = link_to bid.task.title.truncate(30), admin_task_path(bid.task), class: "text-blue-600 hover:text-blue-900"
          td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500
            = bid.user.name || bid.user.phone
          td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500
            = number_to_currency(bid.amount, unit: "Rs. ")
          td.px-6.py-4.whitespace-nowrap
            span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full #{bid.accepted? ? 'bg-green-100 text-green-800' : (bid.rejected? ? 'bg-red-100 text-red-800' : 'bg-yellow-100 text-yellow-800')}"
              = bid.status.humanize
          td.px-6.py-4.whitespace-nowrap.text-sm.text-gray-500
            = bid.created_at.strftime("%Y-%m-%d %H:%M")
          td.px-6.py-4.whitespace-nowrap.text-sm.font-medium.flex.gap-2
            - unless bid.rejected?
              = button_to "Reject", reject_admin_bid_path(bid), method: :patch, class: "bg-red-600 text-white px-3 py-1.5 rounded hover:bg-red-700", data: { confirm: "Force-reject this bid? #{'This will revert the task to open.' if bid.accepted?}" }
            - if bid.pending? && bid.task.open?
              = button_to "Accept", accept_admin_bid_path(bid), method: :patch, class: "bg-green-600 text-white px-3 py-1.5 rounded hover:bg-green-700"
      - if @bids.empty?
        tr
          td.px-6.py-10.text-center.text-gray-500[colspan="6"]
            | No bids found.
.mt-8
  = paginate @bids
