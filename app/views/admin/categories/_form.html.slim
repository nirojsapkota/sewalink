= form_with model: [:admin, category], local: true, class: "space-y-4" do |f|
  - if category.errors.any?
    .rounded-lg.border.border-red-200.bg-red-50.p-3.text-red-700
      ul
        - category.errors.full_messages.each do |msg|
          li = msg
  div
    = f.label :name_en, "Name (English)", class: "block text-sm font-medium text-slate-700"
    = f.text_field :name_en, class: input_class
  div
    = f.label :name_ne, "Name (Nepali)", class: "block text-sm font-medium text-slate-700"
    = f.text_field :name_ne, class: input_class
  div.flex.items-center.gap-2
    = f.check_box :active
    = f.label :active, class: "text-sm font-medium text-slate-700"
  .pt-4
    = f.submit "Save Category", class: button_class(:primary)
