.mb-8.flex.items-center.justify-between
  h1.text-3xl.font-semibold.text-slate-900
    | Categories
  = link_to "New Category", new_admin_category_path, class: button_class(:primary)
.bg-white.rounded-lg.shadow.overflow-hidden
  table.min-w-full.divide-y.divide-slate-200
    thead.bg-slate-50
      tr
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Order
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Name (EN)
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Name (NE)
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Active
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Actions
    tbody.bg-white.divide-y.divide-slate-200
      - @categories.each do |category|
        tr
          td.px-6.py-4.flex.gap-1.whitespace-nowrap.text-sm.text-slate-500
            = button_to "↑", move_up_admin_category_path(category), method: :patch, class: "#{button_class(:secondary)} px-2 py-1"
            = button_to "↓", move_down_admin_category_path(category), method: :patch, class: "#{button_class(:secondary)} px-2 py-1"
          td.px-6.py-4.whitespace-nowrap.text-sm.font-medium.text-slate-900
            = category.name_en
          td.px-6.py-4.whitespace-nowrap.text-sm.text-slate-500
            = category.name_ne
          td.px-6.py-4.whitespace-nowrap
            span class="inline-flex rounded-full px-2 py-0.5 text-xs font-semibold #{status_badge_class(category.active? ? :payment_completed : :draft)}"
              = category.active? ? "Active" : "Inactive"
          td.px-6.py-4.whitespace-nowrap.text-sm.font-medium
            .flex.gap-2
              = link_to 'Edit', edit_admin_category_path(category), class: button_class(:secondary)
              - if category.destroyable?
                = button_to 'Delete', admin_category_path(category), method: :delete, class: button_class(:destructive), data: { confirm: "Delete this category?" }
              - else
                span.text-xs.italic.text-slate-400 In use
      - if @categories.empty?
        tr
          td.px-6.py-10.text-center.text-slate-500[colspan="5"]
            | No categories yet.
