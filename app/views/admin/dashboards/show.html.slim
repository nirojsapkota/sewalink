h1.text-2xl.font-semibold.text-slate-900.mb-4
  | Admin Dashboard
.grid.grid-cols-1.md:grid-cols-3.gap-4
  div class=card_class
    h2.text-lg.font-semibold.text-slate-600
      | Total Users
    p.text-3xl.font-semibold.text-slate-900
      = User.count
  div class=card_class
    h2.text-lg.font-semibold.text-slate-600
      | Open Tasks
    p.text-3xl.font-semibold.text-slate-900
      = Task.where(status: 'open').count
  div class=card_class
    h2.text-lg.font-semibold.text-slate-600
      | Pending Payouts
    p.text-3xl.font-semibold.text-slate-900
      = PayoutRequest.pending.count
.mt-8.grid.grid-cols-1.lg:grid-cols-2.gap-8
  div class=card_class
    h2.text-lg.font-semibold.text-slate-700.mb-4
      | New Users (30d)
    = line_chart @new_users_by_day, xtitle: "Date", ytitle: "Users", colors: ["rgb(79 70 229)"]
  div class=card_class
    h2.text-lg.font-semibold.text-slate-700.mb-4
      | Tasks Completed (30d)
    = line_chart @tasks_completed_by_day, xtitle: "Date", ytitle: "Tasks", colors: ["rgb(34 197 94)"]
  div class="#{card_class} lg:col-span-2"
    h2.text-lg.font-semibold.text-slate-700.mb-4
      | Daily GMV (30d)
    = line_chart @daily_gmv, xtitle: "Date", ytitle: "NPR", prefix: "Rs. ", colors: ["rgb(239 68 68)"]
