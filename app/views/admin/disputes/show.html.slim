.mb-8
  = link_to "← Back to Disputes", admin_disputes_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-700"
  h1 class="mt-4 text-3xl font-semibold text-slate-900" Dispute Resolution: #{@task.title}
  .mt-2.text-sm.text-slate-500.font-mono
    | ID: #{@task.id} | Status:
    span class="inline-flex rounded-full px-2 py-0.5 text-xs font-semibold #{status_badge_class(@task.status)}"
      = @task.status.humanize

.grid.grid-cols-1.lg:grid-cols-3.gap-8
  .lg:col-span-2.space-y-8
    section class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200"
      h2 class="mb-4 flex items-center gap-2 text-xl font-semibold text-slate-900"
        svg class="h-6 w-6 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"
        | Submitted Evidence

      - if @dispute_evidences.any?
        .space-y-6
          - @dispute_evidences.each do |evidence|
            .rounded-xl.border.border-slate-200.bg-slate-50.p-4
              .mb-3.flex.items-start.justify-between
                div
                  span class="font-semibold text-slate-900" = evidence.user.name || evidence.user.phone
                  span class="ml-1 text-xs font-normal text-slate-500"
                    | (# {evidence.user.id == @task.user_id ? "Poster" : "Tasker"})
                .text-xs.text-slate-400
                  = evidence.created_at.strftime("%B %d, %Y at %I:%M %p")

              p class="mb-4 text-sm italic text-slate-600" = evidence.description

              .grid.grid-cols-2.sm:grid-cols-3.gap-4
                - evidence.files.each do |file|
                  .aspect-square.relative.overflow-hidden.rounded-lg.border.border-slate-200.shadow-sm
                    = image_tag file, class: "h-full w-full object-cover"
                    = link_to "View Original", url_for(file), target: "_blank", class: "absolute bottom-1 right-1 rounded bg-slate-900/75 px-2 py-1 text-[10px] text-white"
      - else
        .rounded-xl.border.border-dashed.border-slate-200.bg-slate-50.py-8.text-center.text-slate-400.italic
          | No evidence submitted yet.

    section class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200"
      h2 class="mb-4 flex items-center gap-2 text-xl font-semibold text-slate-900"
        svg class="h-6 w-6 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"
        | Full Conversation History

      - if @conversations.any?
        .space-y-8
          - @conversations.each do |conversation|
            .border-b.border-slate-200.last:border-0.pb-6
              .mb-4.text-xs.font-semibold.uppercase.tracking-wider.text-indigo-600
                | Conversation ID: #{conversation.id}
              .space-y-4
                - conversation.messages.order(created_at: :asc).each do |msg|
                  div class="flex flex-col #{msg.sender_id == @task.user_id ? 'items-start' : 'items-end'}"
                    div class="max-w-[80%] rounded-2xl p-3 text-sm shadow-sm #{msg.sender_id == @task.user_id ? 'bg-indigo-50 text-slate-700' : 'bg-white border border-slate-200 text-slate-700'}"
                      = msg.content
                    .mt-1.px-2.text-[10px].font-medium.text-slate-400
                      | #{msg.sender.name || msg.sender.phone} • #{msg.created_at.strftime("%H:%M")}
      - else
        .rounded-xl.border.border-dashed.border-slate-200.bg-slate-50.py-8.text-center.text-slate-400.italic
          | No messages found for this task.

  .space-y-8
    section class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200"
      h2 class="mb-6 flex items-center gap-2 text-xl font-semibold text-slate-900"
        svg class="h-6 w-6 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
        | Resolution Controls

      .space-y-6
        div
          h3.mb-2.font-semibold.text-slate-900 Option 1: Release Funds
          p class="mb-4 text-xs text-slate-500" Releases the escrowed amount to the Tasker. Mark the task as "Completed".
          = button_to "Release to Tasker", resolve_admin_dispute_path(@task, decision: 'release'), method: :patch, class: "#{button_class(:primary)} w-full", data: { confirm: "Are you sure you want to release funds to the tasker?" }

        .border-t.border-slate-200.pt-6
          h3.mb-2.font-semibold.text-slate-900 Option 2: Refund Poster
          p class="mb-4 text-xs text-slate-500" Refunds the escrowed amount to the Poster's wallet. Mark the task as "Cancelled".
          = button_to "Refund to Poster", resolve_admin_dispute_path(@task, decision: 'refund'), method: :patch, class: "#{button_class(:destructive)} w-full", data: { confirm: "Are you sure you want to refund the poster?" }

        .border-t.border-slate-200.pt-6
          h3.mb-2.font-semibold.text-slate-900 Option 3: Split Payment
          p class="mb-4 text-xs text-slate-500" Splits the escrowed amount between Tasker and Poster by percentage. Marks the task "Completed".
          = form_with url: resolve_admin_dispute_path(@task), method: :patch, local: true, class: "space-y-2" do |f|
            = hidden_field_tag :decision, 'split'
            = label_tag :tasker_percentage, "Tasker %", class: "text-xs font-medium text-slate-700"
            = number_field_tag :tasker_percentage, 60, min: 0, max: 100, class: input_class
            = f.submit "Split Funds", class: "#{button_class(:primary)} w-full", data: { confirm: "Split escrow funds between tasker and poster by this percentage?" }

        .border-t.border-slate-200.pt-6
          h3.mb-2.font-semibold.text-slate-900 Option 4: Reopen Task
          p class="mb-4 text-xs text-slate-500" Unassigns the current tasker and reopens the task for new bids. No funds move.
          = button_to "Reopen Task", resolve_admin_dispute_path(@task, decision: 'reopen'), method: :patch, class: "#{button_class(:secondary)} w-full", data: { confirm: "Reopen this task? The current tasker will be unassigned." }

    section class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200"
      h2 class="mb-4 text-lg font-semibold text-slate-900" Task Details
      .space-y-4.text-sm
        div
          .text-[10px].font-semibold.uppercase.text-slate-400 Amount
          .text-lg.font-semibold.text-green-700 = number_to_currency(@task.budget, unit: "Rs. ")

        div
          .text-[10px].font-semibold.uppercase.text-slate-400 Poster
          .font-medium.text-slate-900 = link_to (@task.user.name || @task.user.phone), admin_user_path(@task.user), class: "text-indigo-600 hover:text-indigo-700"
          .text-xs.text-slate-500 = @task.user.phone

        div
          .text-[10px].font-semibold.uppercase.text-slate-400 Tasker
          - if @task.tasker
            .font-medium.text-slate-900 = link_to (@task.tasker.name || @task.tasker.phone), admin_user_path(@task.tasker), class: "text-indigo-600 hover:text-indigo-700"
            .text-xs.text-slate-500 = @task.tasker.phone
          - else
            .text-slate-400 Not assigned

        div
          .text-[10px].font-semibold.uppercase.text-slate-400 Location
          .text-slate-700 = @task.location

        .border-t.border-slate-200.pt-4
          .mb-1.text-[10px].font-semibold.uppercase.text-slate-400 Description
          p class="text-xs leading-relaxed text-slate-600" = @task.description
