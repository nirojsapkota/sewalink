.mb-8
  h1.text-3xl.font-semibold.text-slate-900
    | Platform Settings
.grid.grid-cols-1.md:grid-cols-3.gap-6.mb-8
  .rounded-lg.border.border-indigo-100.bg-indigo-50.p-4
    span.text-indigo-700.font-medium.block Current Commission Rate
    span.text-2xl.font-semibold.text-slate-900
      = number_to_percentage(@commission_rate.to_f * 100, precision: 2)
  .rounded-lg.border.border-green-200.bg-green-50.p-4
    span.text-green-700.font-medium.block Platform Revenue Balance
    span.text-2xl.font-semibold.text-slate-900
      = @platform_revenue_balance.format
  .rounded-lg.border.border-slate-200.bg-slate-50.p-4
    span.text-slate-700.font-medium.block Total Escrow Held
    span.text-2xl.font-semibold.text-slate-900
      = humanized_money_with_symbol Money.new(@total_escrow_held, 'NPR')

div class="#{card_class} max-w-lg mb-8"
  h2.text-xl.font-semibold.mb-4.border-b.border-slate-200.pb-2
    | Update Commission Rate
  = form_with url: admin_settings_path, method: :patch, local: true, class: "space-y-4" do |f|
    div
      = label_tag :commission_rate, "Commission Rate (decimal, e.g. 0.10 = 10%)", class: "block text-sm font-medium text-slate-700"
      = number_field_tag :commission_rate, @commission_rate, step: 0.01, min: 0, max: 1, class: input_class
    .pt-2
      = f.submit "Update Rate", class: button_class(:primary)

div class="#{card_class} max-w-lg mb-8"
  h2.text-xl.font-semibold.mb-4.border-b.border-slate-200.pb-2
    | Location-Based Check-In
  p.text-sm.text-slate-500.mb-4
    | When enabled, taskers must grant location access and be within 200m
      of an on-site task to start or complete it. Disable this to let
      taskers start and complete on-site tasks without any location
      verification (e.g. for demos, or in areas with unreliable GPS).
  = form_with url: admin_settings_path, method: :patch, local: true, class: "space-y-4" do |f|
    label class="flex items-center gap-3 cursor-pointer"
      = hidden_field_tag :geofence_check_in_enabled, "0"
      = check_box_tag :geofence_check_in_enabled, "1", @geofence_check_in_enabled, class: "h-5 w-5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-600"
      span class="text-sm font-medium text-slate-700"
        | Require location-based check-in for on-site tasks
    .pt-2
      = f.submit "Save Setting", class: button_class(:primary)

.bg-slate-50.p-6.rounded-lg.border.border-dashed.border-slate-300
  h2.text-lg.font-semibold.mb-2.text-slate-700
    | Payment Gateway Configuration
  p.text-sm.text-slate-500
    | eSewa merchant credentials are configured via environment variables (ENV-managed, not database-backed) and are intentionally not editable here to avoid storing payment secrets in the application database. Contact the platform operator to rotate these via the hosting provider's secret manager.
