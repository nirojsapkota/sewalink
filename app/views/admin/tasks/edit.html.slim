.mb-8.flex.justify-between.items-center
  h1.text-3xl.font-bold
    | Edit Task ##{@task.id}
  = link_to "Back to Task", admin_task_path(@task), class: "text-blue-600 hover:text-blue-900"
.bg-white.p-6.rounded-lg.shadow.max-w-2xl
  = form_with model: @task, url: admin_task_path(@task), method: :patch, local: true, class: "space-y-4" do |f|
    div
      = f.label :title, class: "block text-sm font-medium text-gray-700"
      = f.text_field :title, class: "mt-1 block w-full border rounded px-3 py-2"
    div
      = f.label :description, class: "block text-sm font-medium text-gray-700"
      = f.text_area :description, rows: 4, class: "mt-1 block w-full border rounded px-3 py-2"
    div
      = f.label :budget, "Budget (NPR)", class: "block text-sm font-medium text-gray-700"
      = f.number_field :budget, step: 0.01, class: "mt-1 block w-full border rounded px-3 py-2"
    div
      = f.label :category_id, class: "block text-sm font-medium text-gray-700"
      = f.collection_select :category_id, Category.all, :id, :name_en, {}, class: "mt-1 block w-full border rounded px-3 py-2"
    div
      = f.label :location, class: "block text-sm font-medium text-gray-700"
      = f.text_field :location, class: "mt-1 block w-full border rounded px-3 py-2"
    .pt-4
      = f.submit "Save Changes", class: "bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 cursor-pointer"
