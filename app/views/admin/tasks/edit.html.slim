.mb-8.flex.items-center.justify-between
  h1.text-3xl.font-semibold.text-slate-900
    | Edit Task ##{@task.id}
  = link_to "Back to Task", admin_task_path(@task), class: button_class(:secondary)
div class="#{card_class} max-w-2xl"
  = form_with model: @task, url: admin_task_path(@task), method: :patch, local: true, class: "space-y-4" do |f|
    div
      = f.label :title, class: "block text-sm font-medium text-slate-700"
      = f.text_field :title, class: input_class
    div
      = f.label :description, class: "block text-sm font-medium text-slate-700"
      = f.text_area :description, rows: 4, class: input_class
    div
      = f.label :budget, "Budget (NPR)", class: "block text-sm font-medium text-slate-700"
      = f.number_field :budget, step: 0.01, class: input_class
    div
      = f.label :category_id, class: "block text-sm font-medium text-slate-700"
      = f.collection_select :category_id, Category.all, :id, :name_en, {}, class: input_class
    div
      = f.label :location, class: "block text-sm font-medium text-slate-700"
      = f.text_field :location, class: input_class
    .pt-4
      = f.submit "Save Changes", class: button_class(:primary)
