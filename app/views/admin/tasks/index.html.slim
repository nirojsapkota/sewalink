.mb-8
  h1.text-3xl.font-semibold.text-slate-900
    | Task Management
.mb-8.border-b.border-slate-200
  nav.-mb-px.flex.space-x-8
    = link_to "All", admin_tasks_path, class: "#{params[:status].blank? ? 'border-indigo-500 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300'} whitespace-nowrap border-b-2 px-1 py-4 text-sm font-medium"
    - Task.statuses.keys.each do |status|
      = link_to status.humanize, admin_tasks_path(status: status), class: "#{params[:status] == status ? 'border-indigo-500 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300'} whitespace-nowrap border-b-2 px-1 py-4 text-sm font-medium"
.bg-white.rounded-lg.shadow.overflow-hidden
  table.min-w-full.divide-y.divide-slate-200
    thead.bg-slate-50
      tr
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Title
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Poster
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Tasker
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Budget
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Status
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Actions
    tbody.bg-white.divide-y.divide-slate-200
      - @tasks.each do |task|
        tr
          td.px-6.py-4.whitespace-nowrap.text-sm.font-medium.text-slate-900
            = task.title.truncate(30)
          td.px-6.py-4.whitespace-nowrap.text-sm.text-slate-500
            = task.user.name || task.user.phone
          td.px-6.py-4.whitespace-nowrap.text-sm.text-slate-500
            = task.tasker&.name || task.tasker&.phone || "-"
          td.px-6.py-4.whitespace-nowrap.text-sm.text-slate-500
            = humanized_money_with_symbol task.budget
          td.px-6.py-4.whitespace-nowrap
            span class="inline-flex rounded-full px-2 py-0.5 text-xs font-semibold #{status_badge_class(task.status)}"
              = task.status.humanize
          td.px-6.py-4.whitespace-nowrap.text-sm.font-medium
            = link_to 'Show', admin_task_path(task), class: button_class(:secondary)
.mt-8
  = paginate @tasks
