.mb-8.flex.items-center.justify-between
  h1.text-3xl.font-semibold.text-slate-900
    | Task ##{@task.id}: #{@task.title}
  .flex.gap-2
    = link_to 'Edit', edit_admin_task_path(@task), class: button_class(:secondary)
    - unless @task.cancelled? || @task.completed?
      = button_to 'Force Cancel', force_cancel_admin_task_path(@task), method: :patch, class: button_class(:destructive), data: { confirm: "Force-cancel this task? Any escrowed funds will be refunded to the poster." }
    = link_to 'Back to List', admin_tasks_path, class: button_class(:secondary)

.grid.grid-cols-1.md:grid-cols-3.gap-8
  .md:col-span-2.space-y-8
    div class=card_class
      h2.text-xl.font-semibold.mb-4.border-b.border-slate-200.pb-2 Details
      .grid.grid-cols-2.gap-4
        div
          p.text-sm.text-slate-500 Status
          span class="inline-flex rounded-full px-2 py-0.5 text-xs font-semibold #{status_badge_class(@task.status)}"
            = @task.status.humanize
        div
          p.text-sm.text-slate-500 Budget
          p.font-medium.text-slate-900
            = humanized_money_with_symbol @task.budget
            |  (#{@task.payment_type&.humanize || "Not Set"})
        div
          p.text-sm.text-slate-500 Category
          p.font-medium.text-slate-900 = @task.category.name_en
        div
          p.text-sm.text-slate-500 Created At
          p.font-medium.text-slate-900 = @task.created_at.strftime("%Y-%m-%d %H:%M")

      .mt-4
        p.text-sm.text-slate-500 Description
        p.mt-1.text-slate-700 = @task.description

      .mt-4
        p.text-sm.text-slate-500 Location
        p.mt-1.text-slate-700 = @task.location

    - if @task.dispute?
      .rounded-lg.border.border-red-200.bg-red-50.p-6.shadow-sm
        h2.mb-4.text-xl.font-semibold.text-red-700 Dispute Underway
        p.mb-4.text-slate-700 This task is currently in dispute. Platform administrators must resolve it.
        = link_to "Go to Dispute Resolution", admin_dispute_path(@task), class: button_class(:destructive)

    div class=card_class
      h2.text-xl.font-semibold.mb-4.border-b.border-slate-200.pb-2 Photos
      - if @task.photos.attached?
        .grid.grid-cols-2.md:grid-cols-3.gap-4
          - @task.photos.each do |photo|
            = image_tag photo, class: "h-48 w-full rounded-lg object-cover"
      - else
        p.text-slate-500.italic No photos attached.

  .space-y-8
    div class=card_class
      h2.text-xl.font-semibold.mb-4.border-b.border-slate-200.pb-2 Participants
      .space-y-4
        div
          p.text-sm.text-slate-500 Poster
          = link_to admin_user_path(@task.user), class: "mt-1 flex items-center gap-3 rounded p-2 hover:bg-slate-50" do
            .flex.h-10.w-10.items-center.justify-center.rounded-full.bg-indigo-50.font-semibold.text-indigo-600
              = @task.user.first_name&.first || "U"
            div
              p.font-medium.text-indigo-600 = @task.user.name || "Unnamed User"
              p.text-xs.text-slate-500 = @task.user.phone

        - if @task.tasker
          div
            p.text-sm.text-slate-500 Tasker
            = link_to admin_user_path(@task.tasker), class: "mt-1 flex items-center gap-3 rounded p-2 hover:bg-slate-50" do
              .flex.h-10.w-10.items-center.justify-center.rounded-full.bg-slate-100.font-semibold.text-slate-700
                = @task.tasker.first_name&.first || "T"
              div
                p.font-medium.text-indigo-600 = @task.tasker.name || "Unnamed Tasker"
                p.text-xs.text-slate-500 = @task.tasker.phone

    div class=card_class
      h2.text-xl.font-semibold.mb-4.border-b.border-slate-200.pb-2 Transactions
      - if @task.payment_transactions.any?
        .space-y-3
          - @task.payment_transactions.each do |tx|
            .border-b.border-slate-200.pb-2.text-sm.last:border-0
              .flex.justify-between
                span.font-medium.text-slate-900 Payment ##{tx.id}
                - tx_badge_status = tx.completed? ? :payment_completed : :pending_payment
                span class="inline-flex rounded-full px-2 py-0.5 text-xs font-semibold #{status_badge_class(tx_badge_status)}"
                  = tx.status.humanize
              p.text-xs.text-slate-500 = tx.created_at.strftime("%b %d, %Y %H:%M")
              p.break-all.text-xs.font-mono.text-slate-400 = tx.transaction_uuid
              - if tx.external_ref.present?
                p.mt-1.text-xs.text-slate-500 Ref: #{tx.external_ref}
      - else
        p.text-slate-500.italic No transactions found.
