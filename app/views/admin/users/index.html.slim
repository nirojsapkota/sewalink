.mb-8
  h1.text-3xl.font-semibold.text-slate-900
    | Users
div class="#{card_class} mb-8"
  = form_with url: admin_users_path, method: :get, class: "flex gap-4", local: true do |f|
    = f.text_field :query, value: params[:query], placeholder: "Search by phone...", class: input_class
    = f.submit "Search", class: button_class(:primary)
    = link_to "Clear", admin_users_path, class: button_class(:secondary) if params[:query].present?
.bg-white.rounded-lg.shadow.overflow-hidden
  table.min-w-full.divide-y.divide-slate-200
    thead.bg-slate-50
      tr
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | ID
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Phone
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Name
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Role
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Active Role
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Status
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Created At
        th.px-6.py-3.text-left.text-xs.font-medium.text-slate-500.uppercase.tracking-wider
          | Actions
    tbody.bg-white.divide-y.divide-slate-200
      - @users.each do |user|
        tr
          td.px-6.py-4.whitespace-nowrap.text-sm.text-slate-500
            = user.id
          td.px-6.py-4.whitespace-nowrap.text-sm.font-medium.text-slate-900
            = user.phone
          td.px-6.py-4.whitespace-nowrap.text-sm.text-slate-500
            = user.name || "N/A"
          td.px-6.py-4.whitespace-nowrap.text-sm.text-slate-500
            = user.roles&.then { |roles| roles.map { _1.name.humanize }.join(", ") }
          td.px-6.py-4.whitespace-nowrap.text-sm.text-slate-500
            - active_role_status = user.poster? ? :assigned : :payment_completed
            span class="inline-flex rounded-full px-2 py-0.5 text-xs font-semibold #{status_badge_class(active_role_status)}"
              = user.active_role.humanize
          td.px-6.py-4.whitespace-nowrap.text-sm.text-slate-500
            - badge_status = user.suspended? ? :dispute : :payment_completed
            span class="inline-flex rounded-full px-2 py-0.5 text-xs font-semibold #{status_badge_class(badge_status)}"
              = user.suspended? ? 'Suspended' : 'Active'
          td.px-6.py-4.whitespace-nowrap.text-sm.text-slate-500
            = user.created_at.strftime("%Y-%m-%d %H:%M")
          td.px-6.py-4.whitespace-nowrap.text-sm.font-medium
            = link_to 'Show', admin_user_path(user), class: button_class(:secondary)
.mt-8
  = paginate @users
