.mb-8.flex.items-center.justify-between
  h1.text-3xl.font-semibold.text-slate-900 = "User: #{@user.phone}"
  .flex.gap-2
    = link_to "Edit", edit_admin_user_path(@user), class: button_class(:secondary)
    - if @user.suspended?
      = button_to "Reactivate", reactivate_admin_user_path(@user), method: :patch, class: button_class(:primary)
    - else
      = button_to "Suspend", suspend_admin_user_path(@user), method: :patch, params: { suspension_reason: "Manual suspension by admin" }, class: button_class(:destructive), data: { confirm: "Suspend this user? They will be unable to sign in." }
    = link_to "Back to Users", admin_users_path, class: button_class(:secondary)
.grid.grid-cols-1.md:grid-cols-2.gap-8
  div class=card_class
    h2.text-xl.font-semibold.mb-4.border-b.border-slate-200.pb-2
      | Profile Details
    dl.grid.grid-cols-3.gap-4
      dt.font-medium.text-slate-500
        | Name
      dd.col-span-2.text-slate-900
        = @user.name || "N/A"
      dt.font-medium.text-slate-500
        | Phone
      dd.col-span-2.text-slate-900
        = @user.phone
      dt.font-medium.text-slate-500
        | Locale
      dd.col-span-2.text-slate-900
        = @user.locale || "N/A"
      dt.font-medium.text-slate-500
        | Admin Roles
      dd.col-span-2.text-slate-900
        - if @user.roles.any?
          = @user.roles.map(&:name).map(&:titleize).join(", ")
        - else
          | None
      dt.font-medium.text-slate-500
        | Onboarded
      dd.col-span-2.text-slate-900
        = @user.onboarded? ? "Yes" : "No"
      dt.font-medium.text-slate-500
        | Bio
      dd.col-span-2.text-slate-900
        = @user.bio || "N/A"
      dt.font-medium.text-slate-500
        | Status
      dd.col-span-2.text-slate-900
        - badge_status = @user.suspended? ? :dispute : :payment_completed
        span class="inline-flex rounded-full px-2 py-0.5 text-xs font-semibold #{status_badge_class(badge_status)}"
          = @user.suspended? ? "Suspended (#{@user.suspension_reason})" : "Active"
      dt.font-medium.text-slate-500
        | Joined
      dd.col-span-2.text-slate-900
        = @user.created_at.strftime("%Y-%m-%d %H:%M")
  div class=card_class
    h2.text-xl.font-semibold.mb-4.border-b.border-slate-200.pb-2
      | Marketplace Activity
    .grid.grid-cols-1.gap-4
      .flex.items-center.justify-between.rounded-lg.border.border-indigo-100.bg-indigo-50.p-4
        span.font-medium.text-indigo-700
          | Total Tasks Posted
        span.text-2xl.font-semibold.text-slate-900
          = @tasks_posted
      .flex.items-center.justify-between.rounded-lg.border.border-green-200.bg-green-50.p-4
        span.font-medium.text-green-700
          | Tasks Completed (as Poster)
        span.text-2xl.font-semibold.text-slate-900
          = @tasks_completed_as_poster
      .flex.items-center.justify-between.rounded-lg.border.border-slate-200.bg-slate-50.p-4
        span.font-medium.text-slate-700
          | Tasks Completed (as Tasker)
        span.text-2xl.font-semibold.text-slate-900
          = @tasks_completed_as_tasker
      .flex.items-center.justify-between.rounded-lg.border.border-slate-200.bg-slate-50.p-4
        span.font-medium.text-slate-700
          | Current Balance
        span.text-2xl.font-semibold.text-slate-900
          = humanized_money_with_symbol @user.balance
