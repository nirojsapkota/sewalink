div class="mx-auto flex w-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm md:w-2/3"
  .flex.items-center.justify-between.border-b.border-slate-200.bg-slate-50.p-4
    div
      h2.text-lg.font-semibold.text-slate-900 = @conversation.task.title
      p.text-xs.text-slate-500
        | Chatting with 
        - if current_user == @conversation.task.user
          = mask_contact_info(@conversation.bid.user.phone, visible: can_see_contact_info?(@conversation.bid.user, task: @conversation.task))
        - else
          = mask_contact_info(@conversation.task.user.phone, visible: can_see_contact_info?(@conversation.task.user, task: @conversation.task))
    = link_to "Back", task_path(@conversation.task), class: button_class(:ghost)
  
  / Tailwind Safelist for Chat JS: 
  / bg-indigo-600 text-white rounded-br-none justify-end
  / bg-slate-100 text-slate-900 rounded-bl-none justify-start
  
  div#messages class="flex-grow space-y-4 overflow-y-auto bg-white p-4 md:p-6" data-controller="chat" data-chat-current-user-id-value=current_user.id
    = turbo_stream_from @conversation
    = turbo_stream_from current_user
    = render partial: "messages/message", collection: @messages, as: :message, locals: { viewer: current_user }

.border-t.border-slate-200.bg-slate-50.p-4
  = render "messages/form", conversation: @conversation, message: @new_message
