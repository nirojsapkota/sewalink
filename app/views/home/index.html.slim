/ Hero Section
section.max-w-7xl.mx-auto.px-5.py-16.md:py-24.flex.flex-col.md:flex-row.items-center.justify-between.gap-12
  div class="md:w-1/2 text-left space-y-8"
    h1 class="text-4xl md:text-6xl font-semibold text-slate-900 leading-tight"
      = t('landing.hero.title')
    p class="text-xl text-slate-600 max-w-lg"
      = t('landing.hero.subtitle')
    .flex.flex-col.sm:flex-row.space-y-4.sm:space-y-0.sm:space-x-4.pt-4.items-start
      = link_to new_task_path, class: "#{button_class(:primary)} px-8 py-4 text-lg w-full sm:w-auto" do
        = t('landing.hero.cta_post')
      = link_to tasks_path, class: "#{button_class(:ghost)} text-base sm:text-lg w-full sm:w-auto text-center" do
        = t('landing.hero.cta_find')
    
    / Magic Box / AI Voice Hint
    div class="#{card_class} max-w-md flex items-center space-x-4"
      div class="bg-indigo-600 p-3 rounded-full"
        svg.h-6.w-6.text-white xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"
      .text-sm
        p class="text-slate-700 font-semibold italic"
          | "#{t('landing.hero.magic_box_hint')}"

  div class="md:w-1/2 mt-12 md:mt-0"
    div class="#{card_class} rounded-3xl p-8"
      .space-y-6
        .flex.items-center.space-x-4
          .w-12.h-12.rounded-full.bg-slate-200
          .space-y-2
            .h-4.w-32.bg-slate-100.rounded
            .h-3.w-20.bg-slate-50.rounded
        .space-y-3
          div class="h-4 w-full bg-slate-100 rounded"
          div class="h-4 w-5/6 bg-slate-100 rounded"
          div class="h-4 w-4/6 bg-slate-100 rounded"
        .pt-4.flex.justify-between.items-center
          div class="text-green-600 font-semibold text-lg"
            | Rs. 1,500
          div class="bg-indigo-50 text-indigo-700 px-4 py-2 rounded-lg text-sm font-semibold"
            | Offer Made

/ Magic Home Assistant Section
section.max-w-7xl.mx-auto.px-5.py-12 data-controller="voice-assistant"
  div class="bg-slate-900 rounded-[3rem] p-8 md:p-12 text-center text-white shadow-sm relative overflow-hidden group"
    div class="absolute top-0 left-0 w-full h-full opacity-10 bg-[radial-gradient(circle_at_top,_rgba(79,70,229,0.35),_transparent_55%)]"
    .relative.z-10
      h2.text-3xl.md:text-4xl.font-semibold.mb-4
        | Talk to sewaLink (V1.0 Ready)
      p.text-slate-200.text-lg.mb-8.max-w-2xl.mx-auto
        | "Find me a plumber", "I need someone to clean my house", or "Show my dashboard". Just tap and speak!
      button class="inline-flex items-center justify-center w-24 h-24 bg-white text-indigo-600 rounded-full transition-colors duration-150 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900 ring-8 ring-white/20 group-[.recording]:ring-green-500/30 group-[.recording]:text-green-600" data-action="click->voice-assistant#toggleRecording" data-voice-assistant-target="trigger"
        svg class="h-10 w-10 group-[.recording]:animate-pulse" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"
      p class="mt-6 text-sm font-semibold tracking-widest uppercase text-slate-300" data-voice-assistant-target="status"
        | Tap to start

/ How it Works Section
section.bg-white.py-20
  .max-w-7xl.mx-auto.px-5
    .text-center.mb-16
      h2 class="text-3xl md:text-5xl font-semibold text-slate-900"
        = t('landing.how_it_works.title')
      div class="h-1.5 w-24 bg-indigo-600 mx-auto mt-4 rounded-full"
    
    .grid.md:grid-cols-2.gap-12
      / Poster Path
      div class="#{card_class} rounded-3xl p-10 space-y-8"
        h3 class="text-2xl font-semibold text-slate-900 flex items-center"
          span class="bg-indigo-600 text-white w-8 h-8 rounded-full inline-flex items-center justify-center text-sm mr-3"
            | 1
          = t('landing.how_it_works.poster.title')
        ul.space-y-6
          li.flex.items-start.space-x-4
            div class="mt-1 text-green-500"
              svg.h-6.w-6 xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
            p class="text-slate-600"
              = t('landing.how_it_works.poster.step_1')
          li.flex.items-start.space-x-4
            div class="mt-1 text-green-500"
              svg.h-6.w-6 xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
            p class="text-slate-600"
              = t('landing.how_it_works.poster.step_2')
          li.flex.items-start.space-x-4
            div class="mt-1 text-green-500"
              svg.h-6.w-6 xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
            p class="text-slate-600"
              = t('landing.how_it_works.poster.step_3')

      / Tasker Path
      div class="bg-green-50 border border-green-100 rounded-3xl p-10 space-y-8 shadow-sm"
        h3 class="text-2xl font-semibold text-slate-900 flex items-center"
          span class="bg-green-500 text-white w-8 h-8 rounded-full inline-flex items-center justify-center text-sm mr-3"
            | 2
          = t('landing.how_it_works.tasker.title')
        ul.space-y-6
          li.flex.items-start.space-x-4
            div class="mt-1 text-green-500"
              svg.h-6.w-6 xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
            p class="text-slate-600"
              = t('landing.how_it_works.tasker.step_1')
          li.flex.items-start.space-x-4
            div class="mt-1 text-green-500"
              svg.h-6.w-6 xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
            p class="text-slate-600"
              = t('landing.how_it_works.tasker.step_2')
          li.flex.items-start.space-x-4
            div class="mt-1 text-green-500"
              svg.h-6.w-6 xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
            p class="text-slate-600"
              = t('landing.how_it_works.tasker.step_3')

/ Features Grid
section.py-20.bg-slate-50
  .max-w-7xl.mx-auto.px-5
    .text-center.mb-16
      h2 class="text-3xl md:text-5xl font-semibold text-slate-900"
        = t('landing.features.title')
      div class="h-1.5 w-24 bg-indigo-600 mx-auto mt-4 rounded-full"
    
    .grid.md:grid-cols-2.lg:grid-cols-4.gap-8
      / Feature 1: Bilingual
      div class="#{card_class} rounded-3xl p-8 text-center"
        div class="bg-slate-100 text-slate-700 w-16 h-16 rounded-2xl inline-flex items-center justify-center mb-6"
          svg.h-8.w-8 xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
            path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5a18.022 18.022 0 01-3.827-5.802M10.835 12a15.933 15.933 0 01-2.022 4.048M6 19a16.036 16.036 0 01-2.048-4M16 11l5 5m0 0l-5 5m5-5H10"
        h4 class="text-xl font-semibold text-slate-900 mb-3"
          = t('landing.features.bilingual.title')
        p class="text-slate-600 text-sm leading-relaxed"
          = t('landing.features.bilingual.desc')

      / Feature 2: Voice
      div class="#{card_class} rounded-3xl p-8 text-center"
        div class="bg-slate-100 text-slate-700 w-16 h-16 rounded-2xl inline-flex items-center justify-center mb-6"
          svg.h-8.w-8 xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
            path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"
        h4 class="text-xl font-semibold text-slate-900 mb-3"
          = t('landing.features.voice.title')
        p class="text-slate-600 text-sm leading-relaxed"
          = t('landing.features.voice.desc')

      / Feature 3: eSewa
      div class="#{card_class} rounded-3xl p-8 text-center"
        div class="bg-slate-100 text-slate-700 w-16 h-16 rounded-2xl inline-flex items-center justify-center mb-6"
          svg.h-8.w-8 xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
            path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
        h4 class="text-xl font-semibold text-slate-900 mb-3"
          = t('landing.features.payments.title')
        p class="text-slate-600 text-sm leading-relaxed"
          = t('landing.features.payments.desc')

      / Feature 4: Trust
      div class="#{card_class} rounded-3xl p-8 text-center"
        div class="bg-slate-100 text-slate-700 w-16 h-16 rounded-2xl inline-flex items-center justify-center mb-6"
          svg.h-8.w-8 xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
            path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
        h4 class="text-xl font-semibold text-slate-900 mb-3"
          = t('landing.features.trust.title')
        p class="text-slate-600 text-sm leading-relaxed"
          = t('landing.features.trust.desc')

/ Footer CTA
- unless user_signed_in?
  section.py-20
    .max-w-4xl.mx-auto.px-5.text-center
      div class="bg-indigo-600 p-12 md:p-20 rounded-[3rem] shadow-sm relative overflow-hidden"
        div class="absolute top-0 left-0 w-full h-full opacity-10"
          svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg"
            defs
              pattern#grid width="40" height="40" patternUnits="userSpaceOnUse"
                path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="1"
            rect width="100%" height="100%" fill="url(#grid)"
        .relative.z-10.space-y-8
          h2.text-3xl.md:text-5xl.font-semibold.text-white
            = t('landing.cta_footer.title')
          p class="text-xl text-white/80"
            = t('landing.cta_footer.subtitle')
          .pt-6
            = link_to new_user_registration_path, class: "#{button_class(:secondary)} px-12 py-5 rounded-2xl text-xl inline-flex" do
              = t('landing.cta_footer.button')
