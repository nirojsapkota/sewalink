doctype html
html
  head
    title SewaLink | Marketplace for Nepal
    meta[name="viewport" content="width=device-width,initial-scale=1"]
    = csrf_meta_tags
    = csp_meta_tag
    = action_cable_meta_tag
    link[rel="preconnect" href="https://fonts.googleapis.com"]
    link[rel="preconnect" href="https://fonts.gstatic.com" crossorigin]
    link[href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet"]
    = stylesheet_link_tag "tailwind", "data-turbo-track": "reload"
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_importmap_tags

  body[class="bg-white text-slate-600" data-user-signed-in=user_signed_in?.to_s]
    = render "shared/navbar"

    - if user_signed_in?
      = turbo_stream_from current_user, :notifications

    #notifications.fixed.bottom-5.right-5.z-50.flex.flex-col.gap-3.pointer-events-none
      = render "shared/flash"
      - # Real-time toast notifications will be prepended here

    main.container.mx-auto.mt-8.md:mt-12.px-5
      = yield

    footer[class="bg-white border-t border-slate-200 py-10 mt-20"]
      .max-w-7xl.mx-auto.px-5.flex.flex-col.items-center
        .mb-4
          = render "shared/logo"
        p[class="text-sm text-slate-400"] © 2026 sewaLink Nepal. All rights reserved.
