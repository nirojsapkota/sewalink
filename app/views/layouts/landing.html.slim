doctype html
html
  head
    title SewaLink | Get Tasks Done in Nepal
    meta[name="viewport" content="width=device-width,initial-scale=1"]
    = csrf_meta_tags
    = csp_meta_tag
    link[rel="preconnect" href="https://fonts.googleapis.com"]
    link[rel="preconnect" href="https://fonts.gstatic.com" crossorigin]
    link[href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet"]
    = stylesheet_link_tag "tailwind", "data-turbo-track": "reload"
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_importmap_tags

  body[class="bg-white text-slate-600" data-user-signed-in=user_signed_in?.to_s]
    = render "shared/navbar"

    #notifications.fixed.bottom-5.right-5.z-50.flex.flex-col.gap-3.pointer-events-none
      = render "shared/flash"
      - # Real-time toast notifications will be prepended here

    main
      = yield

    footer[class="bg-white border-t border-slate-200 py-12"]
      .max-w-7xl.mx-auto.px-5
        .flex.flex-col.md:flex-row.justify-between.items-center
          .mb-6.md:mb-0
            = render "shared/logo"
          div[class="flex space-x-8 text-slate-500 text-sm font-medium"]
            a class="hover:text-indigo-600 transition-colors" href="#" Privacy Policy
            a class="hover:text-indigo-600 transition-colors" href="#" Terms of Service
            a class="hover:text-indigo-600 transition-colors" href="#" Contact Support
          div[class="mt-8 md:mt-0 text-slate-400 text-xs"] © 2026 sewaLink Nepal. All rights reserved.
