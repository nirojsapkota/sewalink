div#ai_task_preview class=card_class
  - if task
    .mb-4.flex.items-center.justify-between
      span class="#{status_badge_class(task.status)} rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider"
        = t("tasks.statuses.#{task.status}")
      - if task.draft?
        span class="text-[10px] italic text-slate-400"
          = t('live_chats.task_preview.syncing')

    h3 class="mb-2 text-lg font-semibold text-slate-900"
      = task.title.presence || t('live_chats.task_preview.untitled_task')
    
    .space-y-3
      div
        label class="block text-[10px] font-semibold uppercase text-slate-400"
          = t('live_chats.task_preview.description')
        p class="line-clamp-3 text-sm text-slate-600"
          = task.description.presence || t('live_chats.task_preview.describe_placeholder')

      .flex.justify-between.items-end
        div
          label class="block text-[10px] font-semibold uppercase text-slate-400"
            = t('live_chats.task_preview.budget')
          p class="text-lg font-semibold text-indigo-600"
            = (task.budget && task.budget > 0) ? humanized_money_with_symbol(task.budget) : "NPR ---"
        .text-right
          label class="block text-[10px] font-semibold uppercase text-slate-400"
            = t('live_chats.task_preview.location')
          p class="text-sm font-medium text-slate-600"
            = task.location.presence || "---"

    div class="mt-6 border-t border-slate-200 pt-6"
      - if task.draft?
        = link_to t('live_chats.task_preview.review_and_publish'), edit_task_path(task), class: "#{button_class(:primary)} flex w-full justify-center"
      - else
        = link_to t('live_chats.task_preview.view_task'), task_path(task), class: "#{button_class(:secondary)} flex w-full justify-center"
  - else
    .py-12.text-center
      div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-slate-100"
        svg class="h-6 w-6 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
      p class="px-4 text-sm text-slate-400"
        = t('live_chats.task_preview.empty_state')
