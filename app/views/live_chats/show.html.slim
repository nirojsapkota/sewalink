div class="mx-auto max-w-4xl py-10"
  .flex.flex-col.gap-8.md:flex-row
    .flex-1
      h1 class="mb-6 text-3xl font-semibold text-slate-900" = t('live_chats.show.title')

      div [
        class="rounded-3xl border border-slate-200 bg-white p-10 text-center shadow-sm"
        data-controller="real-time-chat"
        data-real-time-chat-user-name-value=(current_user&.first_name || 'there')
        data-real-time-chat-locale-value=(current_user&.locale || I18n.locale)
        data-real-time-chat-tap-to-talk-label-value=t('live_chats.show.tap_to_talk')
        data-real-time-chat-stop-chat-label-value=t('live_chats.show.stop_chat')
        data-real-time-chat-authenticating-label-value=t('live_chats.show.authenticating')
        data-real-time-chat-ready-label-value=t('live_chats.show.ready')
        data-real-time-chat-speaking-label-value=t('live_chats.show.speaking')
        data-real-time-chat-listening-label-value=t('live_chats.show.listening')
        data-real-time-chat-thinking-label-value=t('live_chats.show.thinking')
        data-real-time-chat-connection-lost-label-value=t('live_chats.show.connection_lost')
      ]
        .mb-8
          div class="relative mx-auto mb-4 flex h-32 w-32 items-center justify-center rounded-full bg-slate-100"
            div class="absolute inset-0 hidden rounded-full border-2 border-red-200 bg-red-50" data-real-time-chat-target="status"
            svg class="h-16 w-16 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"
          p class="text-lg font-medium text-slate-700" data-real-time-chat-target="statusLabel"
            = t('live_chats.show.ready_to_talk')

        .flex.justify-center.gap-4
          button [
            class="inline-flex items-center justify-center rounded-full bg-indigo-600 px-10 py-4 text-xl font-semibold text-white transition-colors duration-150 hover:bg-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2"
            type="button"
            data-action="click->real-time-chat#toggleChat"
            data-real-time-chat-target="trigger"
          ]
            = t('live_chats.show.tap_to_talk')

        p class="mt-6 text-sm italic text-slate-500"
          = t('live_chats.show.tip')

    .w-full.md:w-80
      h2 class="mb-6 text-xl font-semibold text-slate-900" = t('live_chats.task_preview.title')
      = turbo_stream_from current_user, :live_chat
      div#ai_task_preview
        = render partial: 'task_preview', locals: { task: @task }
