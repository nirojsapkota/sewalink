- viewer = local_assigns[:viewer]
-   task = message.conversation.task
div id="#{dom_id message}" class="message-bubble flex" data-message-sender-id="#{message.sender_id}" data-chat-target="message"
  div[class="message-bubble-content max-w-[75%] rounded-2xl px-4 py-3 text-sm shadow-sm"]
    p id="#{dom_id message}_text" class="message-text whitespace-pre-wrap"
      = message.viewer_aware_content(viewer)
      span[class="mt-1 block text-right text-[10px] opacity-70"]
        = message.created_at.strftime("%I:%M %p")