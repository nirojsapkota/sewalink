.mx-auto.mt-10.max-w-md
  div class=card_class
    h2.mb-6.text-center.text-2xl.font-semibold.text-slate-900
      = t('onboarding.title')
    .mb-8
      .mb-2.flex.justify-between
        span.rounded-full.bg-indigo-50.px-3.py-1.text-xs.font-semibold.uppercase.text-indigo-700
          | Step
          = " #{@step} of 3"
        span.rounded-full.bg-slate-100.px-3.py-1.text-xs.font-semibold.uppercase.text-slate-700
          = "#{(@step * 100 / 3).to_i}%"
      .h-2.overflow-hidden.rounded-full.bg-slate-100
        div class="h-full bg-indigo-600 transition-all duration-500" style="width:#{(@step * 100 / 3).to_i}%"

    = form_with model: @user, url: onboarding_path(step: @step), method: :patch, local: true do |f|
      - if @user.errors.any?
        .mb-4.rounded-lg.border.border-red-200.bg-red-50.px-4.py-3.text-red-700
          ul.list-inside.list-disc.text-sm
            - @user.errors.full_messages.each do |message|
              li
                = message

      - if @step == 1
        .mb-4.space-y-1.5
          = f.label :first_name, class: "block text-sm font-semibold text-slate-700"
          = f.text_field :first_name, class: input_class, placeholder: "First Name"
        .mb-6.space-y-1.5
          = f.label :last_name, class: "block text-sm font-semibold text-slate-700"
          = f.text_field :last_name, class: input_class, placeholder: "Last Name"
      - elsif @step == 2
        .mb-6
          span.mb-3.block.text-sm.font-semibold.text-slate-700
            = t('onboarding.step_2')
          .space-y-3
            label.flex.cursor-pointer.items-center.gap-3.rounded-lg.border.border-slate-200.p-4.transition-colors.duration-150.hover:border-slate-300.hover:bg-slate-50
              = f.radio_button :locale, 'en', class: "h-4 w-4 border-slate-300 text-indigo-600 focus:ring-indigo-600", checked: I18n.locale == :en
              span.text-sm.text-slate-700
                = t('language.english')
            label.flex.cursor-pointer.items-center.gap-3.rounded-lg.border.border-slate-200.p-4.transition-colors.duration-150.hover:border-slate-300.hover:bg-slate-50
              = f.radio_button :locale, 'ne', class: "h-4 w-4 border-slate-300 text-indigo-600 focus:ring-indigo-600", checked: I18n.locale == :ne
              span.text-sm.text-slate-700
                = t('language.nepali')
      - elsif @step == 3
        .mb-6
          span.mb-3.block.text-sm.font-semibold.text-slate-700
            = t('onboarding.step_3')
          .grid.grid-cols-1.gap-4
            label.cursor-pointer
              = f.radio_button :active_role, 'poster', class: "peer sr-only"
              div class="rounded-lg border-2 border-slate-200 p-4 transition-colors duration-150 hover:border-slate-300 hover:bg-slate-50 peer-checked:border-indigo-600 peer-checked:bg-indigo-50"
                span.block.font-semibold.text-slate-900
                  = t('profiles.roles.poster')
                span.text-sm.text-slate-500
                  = t('onboarding.roles.poster')
            label.cursor-pointer
              = f.radio_button :active_role, 'tasker', class: "peer sr-only"
              div class="rounded-lg border-2 border-slate-200 p-4 transition-colors duration-150 hover:border-slate-300 hover:bg-slate-50 peer-checked:border-indigo-600 peer-checked:bg-indigo-50"
                span.block.font-semibold.text-slate-900
                  = t('profiles.roles.tasker')
                span.text-sm.text-slate-500
                  = t('onboarding.roles.tasker')

      .flex.items-center.justify-center
        = f.submit @step < 3 ? t('onboarding.next') : t('onboarding.finish'), class: "#{button_class(:primary)} w-full"
