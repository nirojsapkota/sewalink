.flex.flex-col.items-center
  - if user.avatar.attached?
    = image_tag user.avatar.variant(resize_to_fill: [150, 150]), class: "mb-4 h-32 w-32 rounded-full object-cover ring-4 ring-slate-100"
  - else
    .mb-4.flex.h-32.w-32.items-center.justify-center.rounded-full.bg-slate-100.text-4xl.font-semibold.text-slate-500
      = user.first_name&.first || "U"
  h2.text-2xl.font-semibold.text-slate-900
    = user.name
  p.mb-1.text-sm.text-slate-500
    = mask_contact_info(user.phone, visible: can_see_contact_info?(user, task: local_assigns[:task]))
  - if user.email.present?
    p.mb-4.text-sm.text-slate-500
      = mask_contact_info(user.email, visible: can_see_contact_info?(user, task: local_assigns[:task]))
  div class="mb-4 rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700"
    = t("profiles.roles.#{user.active_role}")
  - if user.bio.present?
    p.mb-2.text-center.text-slate-600
      = user.bio
