.mx-auto.mt-10.max-w-md
  div class=card_class
    h2.mb-6.text-center.text-2xl.font-semibold.text-slate-900 = t('profiles.edit.title')
    = form_with model: @user, url: profile_path, method: :patch, class: "space-y-4" do |f|
      - if @user.errors.any?
        #error_explanation.mb-4.rounded-lg.border.border-red-200.bg-red-50.p-4.text-red-700
          h2.mb-2.font-semibold
            = pluralize(@user.errors.count, "error")
            |  prohibited this profile from being saved:
          ul.list-inside.list-disc.text-sm
            - @user.errors.full_messages.each do |message|
              li
                = message
      .space-y-1.5
        = f.label :avatar, class: "block text-sm font-semibold text-slate-700"
        - if @user.avatar.attached?
          .flex.items-center.gap-4.py-2
            = image_tag @user.avatar.variant(resize_to_fill: [80, 80]), class: "h-10 w-10 rounded-full object-cover"
            span.text-xs.text-slate-500
              | Change your picture
        = f.file_field :avatar, class: "#{input_class} text-sm file:mr-4 file:rounded-lg file:border-0 file:bg-slate-100 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-slate-700 hover:file:bg-slate-200"
      .space-y-1.5
        = f.label :first_name, class: "block text-sm font-semibold text-slate-700"
        = f.text_field :first_name, class: input_class
      .space-y-1.5
        = f.label :last_name, class: "block text-sm font-semibold text-slate-700"
        = f.text_field :last_name, class: input_class
      .space-y-1.5
        = f.label :bio, class: "block text-sm font-semibold text-slate-700"
        = f.text_area :bio, rows: 4, class: input_class
      .space-y-1.5
        = f.label :locale, t('onboarding.step_2'), class: "block text-sm font-semibold text-slate-700"
        = f.select :locale, [[t('language.english'), 'en'], [t('language.nepali'), 'ne']], {}, class: input_class
      .flex.items-center.justify-between.pt-4
        = link_to t('common.cancel', default: 'Cancel'), profile_path, class: button_class(:ghost)
        = f.submit t('profiles.edit.save'), class: button_class(:primary)