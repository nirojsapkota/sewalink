.mx-auto.mt-10.max-w-md
  div class=card_class
    = render 'profile_info', user: @user
    .mt-6.flex.flex-col.items-center
      .w-full.space-y-3
        = link_to t('profiles.show.edit'), edit_profile_path, class: "#{button_class(:secondary)} flex w-full justify-center"
        = button_to toggle_role_profile_path, method: :patch, class: "#{button_class(:primary)} w-full" do
          - target_role = @user.poster? ? 'tasker' : 'poster'
          = t('profiles.roles.toggle', role: t("profiles.roles.#{target_role}"))