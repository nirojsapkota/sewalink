= form_with(model: [@task, @review], url: task_reviews_path(@task), local: true) do |form|
  - if @review.errors.any?
    #error_explanation.mb-4.rounded-lg.border.border-red-200.bg-red-50.p-4.text-red-700
      h2.mb-2.font-semibold
        = pluralize(@review.errors.count, "error")
        |  prohibited this review from being saved:
      ul.list-inside.list-disc.text-sm
        - @review.errors.full_messages.each do |message|
          li
            = message
  .space-y-4
    .space-y-1.5
      = form.label :rating, class: "block text-sm font-semibold text-slate-700"
      = form.number_field :rating, in: 1..5, step: 1, class: input_class
    .space-y-1.5
      = form.label :comment, class: "block text-sm font-semibold text-slate-700"
      = form.text_area :comment, class: input_class
  - if current_user == @task.tasker
    .space-y-1.5
      = form.label :private_note, "Private Note (visible to Admins only)", class: "block text-sm font-semibold text-slate-700"
      = form.text_area :private_note, class: input_class
    .flex.items-start.gap-2
      = form.check_box :is_public, checked: false, class: "mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-600"
      = form.label :is_public, "Make review public (for Poster feedback)", class: "text-sm text-slate-600"
  - else
    .flex.items-start.gap-2
      = form.check_box :is_public, checked: true, class: "mt-1 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-600"
      = form.label :is_public, "Make review public", class: "text-sm text-slate-600"
  .mt-6
    = form.submit "Submit Review", class: button_class(:primary)