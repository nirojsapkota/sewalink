nav.bg-white.border-b.border-slate-200.sticky.top-0.z-50 data-controller="mobile-menu" aria-expanded="false"
  .container.mx-auto.px-5.py-4.flex.items-center.justify-between
    .flex.items-center.space-x-6
      = link_to root_path, class: "transition-opacity duration-150 hover:opacity-80" do
        = render "shared/logo"

      .hidden.md:flex.space-x-4.items-center
        - if user_signed_in?
          - if current_user.poster?
            = link_to t("dashboards.poster.title"), poster_dashboard_path, class: nav_link_class(poster_dashboard_path)
            = link_to t("tasks.new.title"), new_task_path, class: nav_link_class(new_task_path)
            = link_to t("live_chats.show.title"), live_chat_path, class: nav_link_class(live_chat_path)
          - else
            = link_to t("tasks.index.find_tasks"), tasks_path, class: nav_link_class(tasks_path)
            = link_to t("dashboards.tasker.title"), tasker_dashboard_path, class: nav_link_class(tasker_dashboard_path)
            = link_to t("live_chats.show.title"), live_chat_path, class: nav_link_class(live_chat_path)
          .h-4.w-px.bg-slate-200.mx-2

        = link_to t('language.english'), url_for(locale: :en), class: language_link_class(url_for(locale: :en))
        = link_to t('language.nepali'), url_for(locale: :ne), class: language_link_class(url_for(locale: :ne))

    .flex.items-center.space-x-4
      - if user_signed_in?
        .hidden.md:flex.items-center.space-x-4
          - target_role = current_user.poster? ? 'tasker' : 'poster'
          = button_to toggle_role_profile_path, method: :patch, class: "flex items-center space-x-2 bg-slate-100 text-slate-700 px-3 py-1.5 rounded-full text-xs font-semibold hover:bg-slate-200 transition-colors duration-150 cursor-pointer" do
            span.inline-block.w-2.h-2.rounded-full.bg-green-500
            span = t("profiles.roles.#{current_user.active_role}")
            span.text-slate-400 = "|"
            span.text-xs.opacity-70 = t("profiles.roles.toggle", role: t("profiles.roles.#{target_role}"))

          .flex.items-center.space-x-3
            = link_to profile_path, class: nav_link_class(profile_path) do
              = t("profiles.show.title")
            = button_to destroy_user_session_path, method: :delete, class: "text-sm font-semibold text-red-600 hover:text-red-700 transition-colors duration-150 cursor-pointer" do
              = t("logout")
      - else
        .hidden.md:flex.items-center.space-x-4
          = link_to t("login"), new_user_session_path, class: "text-sm font-semibold text-indigo-600 hover:text-indigo-700 transition-colors duration-150"
          = link_to t("register"), new_user_registration_path, class: button_class(:primary)

      button type="button" class="md:hidden inline-flex items-center justify-center rounded-lg p-2 text-slate-600 hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600" data-action="click->mobile-menu#toggle" aria-label="Toggle navigation menu"
        svg data-mobile-menu-target="openIcon" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"
        svg data-mobile-menu-target="closeIcon" class="hidden h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"

  div data-mobile-menu-target="panel" class="hidden md:hidden border-t border-slate-200 bg-white px-5 py-4 space-y-1"
    - if user_signed_in?
      - if current_user.poster?
        = link_to t("dashboards.poster.title"), poster_dashboard_path, class: "block #{nav_link_class(poster_dashboard_path)} py-2", data: { action: "click->mobile-menu#close" }
        = link_to t("tasks.new.title"), new_task_path, class: "block #{nav_link_class(new_task_path)} py-2", data: { action: "click->mobile-menu#close" }
        = link_to t("live_chats.show.title"), live_chat_path, class: "block #{nav_link_class(live_chat_path)} py-2", data: { action: "click->mobile-menu#close" }
      - else
        = link_to t("tasks.index.find_tasks"), tasks_path, class: "block #{nav_link_class(tasks_path)} py-2", data: { action: "click->mobile-menu#close" }
        = link_to t("dashboards.tasker.title"), tasker_dashboard_path, class: "block #{nav_link_class(tasker_dashboard_path)} py-2", data: { action: "click->mobile-menu#close" }
        = link_to t("live_chats.show.title"), live_chat_path, class: "block #{nav_link_class(live_chat_path)} py-2", data: { action: "click->mobile-menu#close" }
      = link_to t("profiles.show.title"), profile_path, class: "block #{nav_link_class(profile_path)} py-2", data: { action: "click->mobile-menu#close" }

      - target_role = current_user.poster? ? 'tasker' : 'poster'
      = button_to toggle_role_profile_path, method: :patch, class: "flex w-full items-center space-x-2 bg-slate-100 text-slate-700 px-3 py-2 rounded-lg text-xs font-semibold hover:bg-slate-200 transition-colors duration-150 cursor-pointer", data: { turbo_action: "advance" } do
        span.inline-block.w-2.h-2.rounded-full.bg-green-500
        span = t("profiles.roles.#{current_user.active_role}")
        span.text-slate-400 = "|"
        span.text-xs.opacity-70 = t("profiles.roles.toggle", role: t("profiles.roles.#{target_role}"))

      = button_to t("logout"), destroy_user_session_path, method: :delete, class: "block w-full text-left py-2 text-sm font-semibold text-red-600 hover:text-red-700 transition-colors duration-150 cursor-pointer"
    - else
      = link_to t("login"), new_user_session_path, class: "block py-2 text-sm font-semibold text-indigo-600 hover:text-indigo-700 transition-colors duration-150"
      = link_to t("register"), new_user_registration_path, class: "block py-2 #{button_class(:primary)} text-center"

  .md:hidden.bg-slate-50.px-5.py-2.flex.justify-center.space-x-6.border-t.border-slate-200
    = link_to t('language.english'), url_for(locale: :en), class: language_link_class(url_for(locale: :en))
    = link_to t('language.nepali'), url_for(locale: :ne), class: language_link_class(url_for(locale: :ne))
