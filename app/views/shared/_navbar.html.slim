nav.bg-white.border-b.border-slate-200.sticky.top-0.z-50
  .container.mx-auto.px-5.py-4.flex.items-center.justify-between
    .flex.items-center.space-x-6
      = link_to root_path, class: "transition-opacity duration-150 hover:opacity-80" do
        = render "shared/logo"

      .hidden.md:flex.space-x-4.items-center
        - if user_signed_in?
          - if current_user.poster?
            = link_to t("dashboards.poster.title"), poster_dashboard_path, class: nav_link_class(poster_dashboard_path)
            = link_to t("tasks.new.title"), new_task_path, class: nav_link_class(new_task_path)
            = link_to t("live_chats.show.title"), live_chat_path, class: nav_link_class(live_chat_path)
          - else
            = link_to t("tasks.index.find_tasks"), tasks_path, class: nav_link_class(tasks_path)
            = link_to t("dashboards.tasker.title"), tasker_dashboard_path, class: nav_link_class(tasker_dashboard_path)
          .h-4.w-px.bg-slate-200.mx-2

        = link_to t('language.english'), url_for(locale: :en), class: language_link_class(url_for(locale: :en))
        = link_to t('language.nepali'), url_for(locale: :ne), class: language_link_class(url_for(locale: :ne))

    .flex.items-center.space-x-4
      - if user_signed_in?
        - target_role = current_user.poster? ? 'tasker' : 'poster'
        = button_to toggle_role_profile_path, method: :patch, class: "flex items-center space-x-2 bg-slate-100 text-slate-700 px-3 py-1.5 rounded-full text-xs font-semibold hover:bg-slate-200 transition-colors duration-150 cursor-pointer" do
          span.inline-block.w-2.h-2.rounded-full.bg-green-500
          span = t("profiles.roles.#{current_user.active_role}")
          span.text-slate-400 = "|"
          span.text-xs.opacity-70 = t("profiles.roles.toggle", role: t("profiles.roles.#{target_role}"))

        .flex.items-center.space-x-3
          = link_to profile_path, class: nav_link_class(profile_path) do
            = t("profiles.show.title")
          = button_to destroy_user_session_path, method: :delete, class: "text-sm font-semibold text-red-600 hover:text-red-700 transition-colors duration-150 cursor-pointer" do
            = t("logout")
      - else
        = link_to t("login"), new_user_session_path, class: "text-sm font-semibold text-indigo-600 hover:text-indigo-700 transition-colors duration-150"
        = link_to t("register"), new_user_registration_path, class: button_class(:primary)

  .md:hidden.bg-slate-50.px-5.py-2.flex.justify-center.space-x-6.border-t.border-slate-200
    = link_to t('language.english'), url_for(locale: :en), class: language_link_class(url_for(locale: :en))
    = link_to t('language.nepali'), url_for(locale: :ne), class: language_link_class(url_for(locale: :ne))
