.max-w-4xl.mx-auto.px-4.sm:px-6.lg:px-8.py-8
  h1 class="text-3xl font-semibold text-slate-900 mb-8" = t('.wallet_title', default: 'My Wallet')
  
  .grid.grid-cols-1.md:grid-cols-3.gap-6.mb-8
    div class=card_class
      h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider" = t('.current_balance', default: 'Current Balance')
      p class="mt-2 text-3xl font-semibold #{@balance.positive? ? 'text-green-600' : 'text-slate-900'}" = @balance.format
    
    div class=card_class
      h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider" = t('.potential_income', default: 'Potential Income (Pending Bids)')
      p class="mt-2 text-2xl font-semibold text-slate-900" Rs. #{@pending_bids_total}
    
    div class="#{card_class} flex flex-col justify-center border-indigo-200"
      = link_to t('.request_payout', default: 'Request Payout'), '#payout-form', class: "w-full text-center #{button_class(:primary)}"

  .bg-white.rounded-xl.shadow-sm.border.border-slate-200.overflow-hidden.mb-8
    .px-6.py-4.border-b.border-slate-200.flex.justify-between.items-center
      h2 class="text-lg font-semibold text-slate-900" = t('.recent_transactions', default: 'Recent Transactions')
    
    .overflow-x-auto
      table.min-w-full.divide-y.divide-slate-200
        thead.bg-slate-50
          tr
            th class="px-6.py-3.text-left.text-xs.font-semibold.text-slate-500.uppercase.tracking-wider" = t('.date', default: 'Date')
            th class="px-6.py-3.text-left.text-xs.font-semibold.text-slate-500.uppercase.tracking-wider" = t('.type', default: 'Type')
            th class="px-6.py-3.text-right.text-xs.font-semibold.text-slate-500.uppercase.tracking-wider" = t('.amount', default: 'Amount')
        
        tbody class="bg-white divide-y divide-slate-200"
          - if @transactions.any?
            - @transactions.each do |tx|
              tr
                td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500" = tx.created_at.strftime("%b %d, %Y")
                td class="px-6 py-4 whitespace-nowrap text-sm text-slate-900" = tx.code.to_s.humanize
                td class="px-6 py-4 whitespace-nowrap text-sm text-right font-semibold #{tx.amount > 0 ? 'text-green-600' : 'text-red-600'}"
                  = tx.amount.format
          - else
            tr
              td class="px-6 py-8 text-center text-sm text-slate-500" colspan="3" = t('.no_transactions', default: 'No transactions found.')

  #payout-form class=card_class
    h2 class="text-lg font-semibold text-slate-900 mb-4" = t('.payout_request', default: 'Submit Payout Request')
    
    - if @balance >= Money.new(500_00, 'NPR')
      = form_with(model: @payout_request, url: tasker_payout_requests_path, local: true, class: "space-y-4") do |f|
        .flex.flex-col
          = f.label :amount, t('.amount_to_withdraw', default: 'Amount (NPR)'), class: "text-sm font-semibold text-slate-700 mb-1.5"
          = f.number_field :amount, min: 500, max: @balance.to_f, class: input_class, placeholder: "Minimum 500"
          p class="text-xs text-slate-500 mt-1" = t('.min_amount_help', default: 'Minimum withdrawal: Rs. 500')
        
        .flex.flex-col
          = f.label :payment_details, t('.eSewa_ID', default: 'eSewa ID (Phone Number)'), class: "text-sm font-semibold text-slate-700 mb-1.5"
          = f.text_field :payment_details, class: input_class, placeholder: "e.g. 98XXXXXXXX"
        
        = f.submit t('.submit_request', default: 'Submit Withdrawal Request'), class: "w-full #{button_class(:primary)}"
    - else
      .bg-amber-50.border-l-4.border-amber-400.p-4.rounded-r-lg
        p class="text-sm text-amber-700" = t('.insufficient_balance_msg', default: 'You need at least Rs. 500 in your wallet to request a payout.')
