div id=dom_id(task)
  div class="#{card_class} mb-5 border-indigo-200"
    .flex.justify-between.items-start
      div
        h2.text-3xl.font-semibold.text-slate-900 = task.title
        p.text-slate-600 = task.category&.send(I18n.locale == :ne ? :name_ne : :name_en) || "No Category"
      
      .text-right
        span class="inline-block px-3 py-1 text-sm font-semibold rounded-full #{status_badge_class(task.status)}"
          = t("tasks.statuses.#{task.status}")
        p class="text-xl font-semibold text-indigo-600 mt-1" Rs. #{number_with_delimiter(task.budget)}

  .grid.grid-cols-1.md:grid-cols-2.gap-8
    div
      h3.text-lg.font-semibold.mb-2 = t('.description', default: 'Description')
      p.text-slate-700.whitespace-pre-wrap = task.description
      
      h3.text-lg.font-semibold.mt-6.mb-2 = t('.location', default: 'Location')
      p.text-slate-700 = task.location
      
    div
      - if task.photos.attached?
        h3.text-lg.font-semibold.mb-2 = t('.photos', default: 'Photos')
        .grid.grid-cols-2.gap-2
          - task.photos.each do |photo|
            = image_tag photo, class: "rounded-lg object-cover w-full h-48 cursor-pointer border border-slate-200 hover:opacity-90 transition-opacity", 
                        data: { controller: "lightbox", action: "click->lightbox#zoom" }
