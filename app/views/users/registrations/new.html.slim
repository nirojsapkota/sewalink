.mx-auto.mt-10.max-w-md
  div class=card_class
    h2.mb-6.text-center.text-2xl.font-semibold.text-slate-900
      = t('register')
    = form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f|
      = render "users/shared/error_messages", resource: resource
      .space-y-1.5
        = f.label :phone, t('auth.phone'), class: "block text-sm font-semibold text-slate-700"
        = f.text_field :phone, autofocus: true, placeholder: "98XXXXXXXX", class: input_class
        p.text-xs.text-slate-500.italic
          | Example: 9812345678
      .space-y-1.5
        = f.label :email, t('auth.email'), class: "block text-sm font-semibold text-slate-700"
        = f.email_field :email, autocomplete: "email", class: input_class
      .space-y-1.5
        = f.label :password, t('auth.password'), class: "block text-sm font-semibold text-slate-700"
        = f.password_field :password, autocomplete: "new-password", class: input_class
        - if @minimum_password_length
          p.text-xs.text-slate-500.italic
            = "#{@minimum_password_length} #{t('auth.characters_minimum', default: 'characters minimum')}"
      .space-y-1.5
        = f.label :password_confirmation, t('auth.password_confirmation', default: 'Confirm Password'), class: "block text-sm font-semibold text-slate-700"
        = f.password_field :password_confirmation, autocomplete: "new-password", class: input_class
      .pt-2
        = f.submit t('register'), class: "#{button_class(:primary)} w-full"
  .mt-6.text-center
    = render "users/shared/links"
