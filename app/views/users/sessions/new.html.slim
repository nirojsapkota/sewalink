.mx-auto.mt-10.max-w-md
  div class=card_class
    h2.mb-6.text-center.text-2xl.font-semibold.text-slate-900
      = t('login')
    .mb-6.flex.justify-center.gap-3
      button#toggle-phone class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition-colors duration-150 hover:bg-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2"
        = t('auth.login_phone')
      button#toggle-email class="rounded-lg bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-600 transition-colors duration-150 hover:bg-slate-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 focus-visible:ring-offset-2"
        = t('auth.login_email')
    #phone-login-form
      = form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f|
        = hidden_field_tag :login_method, 'phone'
        .space-y-1.5
          = f.label :phone, t('auth.phone'), class: "block text-sm font-semibold text-slate-700"
          = f.text_field :phone, autofocus: true, placeholder: "98XXXXXXXX", class: input_class
        .pt-2
          = f.submit t('auth.submit'), class: "#{button_class(:primary)} w-full"
    #email-login-form.hidden
      = form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f|
        = hidden_field_tag :login_method, 'email'
        .space-y-1.5
          = f.label :email, t('auth.email'), class: "block text-sm font-semibold text-slate-700"
          = f.email_field :email, autocomplete: "email", class: input_class
        .space-y-1.5
          = f.label :password, t('auth.password'), class: "block text-sm font-semibold text-slate-700"
          = f.password_field :password, autocomplete: "current-password", class: input_class
        - if devise_mapping.rememberable?
          .flex.items-center.gap-2
            = f.check_box :remember_me, class: "h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-600"
            = f.label :remember_me, class: "text-sm text-slate-600"
        .pt-2
          = f.submit t('auth.submit'), class: "#{button_class(:primary)} w-full"
  .mt-6.text-center
    = render "users/shared/links"

javascript:
  document.addEventListener('turbo:load', function() {
    const togglePhoneBtn = document.getElementById('toggle-phone');
    const toggleEmailBtn = document.getElementById('toggle-email');
    const phoneForm = document.getElementById('phone-login-form');
    const emailForm = document.getElementById('email-login-form');

    if (togglePhoneBtn && toggleEmailBtn && phoneForm && emailForm) {
      togglePhoneBtn.addEventListener('click', function() {
        phoneForm.classList.remove('hidden');
        emailForm.classList.add('hidden');
        togglePhoneBtn.classList.replace('bg-slate-100', 'bg-indigo-600');
        togglePhoneBtn.classList.replace('text-slate-600', 'text-white');
        toggleEmailBtn.classList.replace('bg-indigo-600', 'bg-slate-100');
        toggleEmailBtn.classList.replace('text-white', 'text-slate-600');
      });

      toggleEmailBtn.addEventListener('click', function() {
        emailForm.classList.remove('hidden');
        phoneForm.classList.add('hidden');
        toggleEmailBtn.classList.replace('bg-slate-100', 'bg-indigo-600');
        toggleEmailBtn.classList.replace('text-slate-600', 'text-white');
        togglePhoneBtn.classList.replace('bg-indigo-600', 'bg-slate-100');
        togglePhoneBtn.classList.replace('text-white', 'text-slate-600');
      });
    }
  });
