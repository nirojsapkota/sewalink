.mx-auto.mt-10.max-w-md
  div class=card_class
    h2.mb-6.text-center.text-2xl.font-semibold.text-slate-900
      = t('auth.verify_otp')
    - if @dev_otp
      .mb-4.rounded-lg.border.border-amber-200.bg-amber-50.p-3.text-center
        p.text-sm.font-medium.text-amber-700
          | Your OTP:
        span.text-lg.font-mono.text-slate-900
          = @dev_otp
    p.mb-6.text-center.text-slate-600
      = t('auth.otp_sent')
      br
      span.font-semibold.text-indigo-600
        = @phone
    = form_tag verify_otp_path, method: :post, class: "space-y-4" do
      .space-y-1.5
        = label_tag :otp, t('auth.otp'), class: "block text-sm font-semibold text-slate-700"
        = text_field_tag :otp, nil, autofocus: true, placeholder: "000000", class: "#{input_class} text-center text-2xl tracking-widest", maxlength: 6
      .pt-2
        = submit_tag t('auth.verify_otp'), class: "#{button_class(:primary)} w-full"
    .mt-6.text-center
      = button_to t('auth.resend_otp'), resend_otp_path, class: button_class(:ghost)
      br
      = link_to t('login'), new_user_session_path, class: button_class(:ghost)
